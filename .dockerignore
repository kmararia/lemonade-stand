# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Ignore log files
*.log

# Ignore system-generated files
.DS_Store
Thumbs.db

# Ignore binary files
**.pyc

# Ignore environment and secret files
.env
.venv
.-venv
._venv
config.json

# Ignore temporary directories
_dev/
_tmp_/
tmp/

# Reflex generated files
.states
.web
*.db
assets/external/
*.py[cod]

# Ignore VS Code workspace settings
.vscode/

# Ignore tests suites and fixtures except the mock directory
tests/*
!tests/_mocks/
!tests/data/inputs
!tests/model/inputs/training.csv
