:{$PORT:8080} {
    # Compress text responses to make the site load even faster
    encode gzip

    # Bundle all Python backend routes into a single named matcher
    @backend_routes path /_event* /ping* /upload* /_upload*

    # Route matched backend traffic to the FastAPI server
    handle @backend_routes {
        reverse_proxy 127.0.0.1:8000
    }

    # Route all other traffic to the unzipped static React frontend
    handle {
        root * /lemonade-stand/public
        try_files {path} {path}/ {path}.html /404.html
        file_server
    }
}
