:{$PORT:8080} {
    # Route interactive events and uploads to the Python backend
    reverse_proxy /_event* 127.0.0.1:8000
    reverse_proxy /ping* 127.0.0.1:8000
    reverse_proxy /upload* 127.0.0.1:8000

    # Serve the static React frontend directly via Caddy
    root * /lemonade-stand/public
    file_server

    # Handle client-side routing (React/NextJS)
    try_files {path} {path}.html /404.html
}
